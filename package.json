{
  "name": "msvc600-lsp",
  "version": "0.1.0",
  "description": "LSP server for Microsoft Visual C++ 6.0 (MSVC6) running under Wine on Linux",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.4.0",
  "bin": {
    "msvc600-lsp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/config.test.ts tests/cli.test.ts tests/diagnostics.test.ts tests/wine-path.test.ts tests/compiler.test.ts",
    "lint": "shellcheck scripts/*.sh",
    "check": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun install --frozen-lockfile && bun run check",
    "doctor": "bash scripts/doctor.sh",
    "start": "bun dist/server.js --stdio",
    "setup": "bash scripts/setup-includes.sh"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18",
    "bun": "1.4.0"
  }
}
