{
  "name": "msvc600-lsp",
  "version": "0.1.0",
  "description": "LSP server for Microsoft Visual C++ 6.0 (MSVC6) running under Wine on Linux",
  "main": "dist/server.js",
  "packageManager": "bun@1.4.0",
  "bin": {
    "msvc600-lsp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint:shell": "shellcheck scripts/*.sh",
    "check": "bun run lint && bun run typecheck && bun run lint:shell && yamllint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "bun dist/server.js --stdio",
    "setup": "bash scripts/setup-includes.sh"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
