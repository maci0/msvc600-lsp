# Environment configuration for the msvc600-lsp server.
# Every variable is optional. Precedence, lowest to highest:
# built-in defaults -> these variables -> client initializationOptions.
# Bun loads this file automatically; export the variables yourself otherwise.

# Root of the MSVC 6.0 installation. Default: <package root>/VC/VC98
MSVC6_BASE_PATH=

# Absolute path to CL.EXE. Default: <MSVC6_BASE_PATH>/BIN/CL.EXE
MSVC6_CL_PATH=

# Include directories passed to CL.EXE as /I, separated by the platform
# path delimiter (":" on Linux/macOS, ";" on Windows). Set to empty to clear
# the list. Default: C:\msvc6\include (Wine) or <base>/INCLUDE (native).
MSVC6_INCLUDE_PATHS=

# Warning level 0-4. Default: 4
MSVC6_WARN_LEVEL=

# Extra flags forwarded verbatim to CL.EXE, whitespace separated.
# Default: empty. Honored only from initializationOptions or this file, never
# from workspace/didChangeConfiguration.
MSVC6_ADDITIONAL_FLAGS=

# Path to the Wine binary. Default: wine
MSVC6_WINE_EXECUTABLE=

# Whether to invoke CL.EXE through Wine: true/false/1/0/yes/no/on/off.
# Default: true on Linux and macOS, false on Windows.
MSVC6_USE_WINE=

# Wall-clock limit for a single CL.EXE invocation, in milliseconds.
# Default: 30000
MSVC6_COMPILE_TIMEOUT_MS=

# Maximum CL.EXE output captured before truncation, in bytes. Default: 1048576
MSVC6_MAX_OUTPUT_BYTES=

# Delay between the last edit and a syntax check, in milliseconds. Default: 300
MSVC6_DEBOUNCE_MS=
